-- ========== 核心功能 ==========
local enabled = false
local fireTargetSphere = nil
local outerListenerConn = nil
local permanentLockConn = nil
local lockedWoods = {}

-- 球体受击动画（瞬间下降4格，然后复位）
local function playSphereHit()
    if not fireTargetSphere then return end
    local originalCF = fireTargetSphere.CFrame
    local downCF = originalCF * CFrame.new(0, -4, 0)   -- 向下4格
    -- 使用 Tween 快速下移并弹回
    local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local downTween = TweenService:Create(fireTargetSphere, tweenInfo, {CFrame = downCF})
    local upTween = TweenService:Create(fireTargetSphere, tweenInfo, {CFrame = originalCF})
    downTween:Play()
    downTween.Completed:Connect(function()
        upTween:Play()
    end)
end

local function getFirePlace()
    local campground = workspace:FindFirstChild("Campground")
    if campground then
        return campground:FindFirstChild("MainFire")
    end
    return nil
end

local function createTargetSphere()
    local existing = workspace:FindFirstChild("FireTargetSphere")
    if existing then existing:Destroy() end
    local firePlace = getFirePlace()
    local basePos = firePlace and (firePlace:GetPivot().Position + Vector3.new(0, 14, 1)) or Vector3.new(0, 14, 1)
    local sphere = Instance.new("Part")
    sphere.Name = "FireTargetSphere"
    sphere.Shape = Enum.PartType.Ball
    sphere.Size = Vector3.new(7,7,7)
    sphere.CFrame = CFrame.new(basePos)
    sphere.BrickColor = BrickColor.new("Really red")
    sphere.Material = Enum.Material.Neon
    sphere.Anchored = true          -- 物理锁定，但 CFrame 仍可被脚本移动
    sphere.CanCollide = false
    sphere.Parent = workspace
    print("球体已创建，固定位置:", basePos)
    return sphere
end

-- 永久锁定木头
local function startPermanentLock()
    if permanentLockConn then return end
    permanentLockConn = RunService.Heartbeat:Connect(function()
        if not fireTargetSphere or not fireTargetSphere.Parent then return end
        local targetPos = fireTargetSphere.Position
        for wood, _ in pairs(lockedWoods) do
            if wood and wood.Parent then
                local root = wood:IsA("BasePart") and wood or (wood.PrimaryPart or wood:FindFirstChildWhichIsA("BasePart"))
                if root then
                    root.CFrame = CFrame.new(targetPos)
                end
            else
                lockedWoods[wood] = nil
            end
        end
    end)
end

local function teleportAndLock(wood)
    if not wood or not wood.Parent then return end
    if not fireTargetSphere or not fireTargetSphere.Parent then return end
    local root = wood:IsA("BasePart") and wood or (wood.PrimaryPart or wood:FindFirstChildWhichIsA("BasePart"))
    if not root then return end
    -- 木头瞬移到球体中心
    root.CFrame = CFrame.new(fireTargetSphere.Position)
    -- 加入锁定
    if not lockedWoods[wood] then
        lockedWoods[wood] = true
        startPermanentLock()
    end
    -- 触发球体受击动画（下坠4格并弹回）
    playSphereHit()
    print("木头已瞬移并触发球体下坠效果:", wood.Name)
end

local function handleExisting()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Outer" then
            teleportAndLock(obj)
        end
    end
end

local function startAll()
    if enabled then return end
    enabled = true
    fireTargetSphere = createTargetSphere()
    handleExisting()
    if outerListenerConn then outerListenerConn:Disconnect() end
    outerListenerConn = workspace.DescendantAdded:Connect(function(obj)
        if obj.Name == "Outer" and enabled then
            task.wait(0.05)
            teleportAndLock(obj)
        end
    end)
    print("[系统] 已开启（球体受击下坠效果）")
end

local function stopAll()
    if not enabled then return end
    enabled = false
    if outerListenerConn then outerListenerConn:Disconnect(); outerListenerConn = nil end
    if permanentLockConn then permanentLockConn:Disconnect(); permanentLockConn = nil end
    lockedWoods = {}
    if fireTargetSphere and fireTargetSphere.Parent then
        fireTargetSphere:Destroy()
        fireTargetSphere = nil
    end
    print("[系统] 已关闭")
end

-- ========== 删除 AntiFlingClient 脚本 ==========
local function deleteAntiFlingClient()
    showNotification("请不要开启功能请等待20秒删除反作弊脚本", 5)
    local count = 0
    for _, obj in ipairs(game:GetDescendants()) do
        if (obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript")) and obj.Name == "AntiFlingClient" then
            obj:Destroy()
            count = count + 1
            print("已删除:", obj:GetFullName())
        end
    end
    print("共删除", count, "个 AntiFlingClient 脚本")
end

