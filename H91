-- 自动吸入篝火（瞬移+清理飞马）+ 可拖拽界面
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

local remoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
local startDrag = remoteEvents and remoteEvents:FindFirstChild("RequestStartDraggingItem")
local burnEvent = remoteEvents and remoteEvents:FindFirstChild("RequestBurnItem")

-- ========== 核心功能（受开关控制）==========
local enabled = false
local fireTargetSphere = nil
local antiCleanupConn = nil
local outerListenerConn = nil
local heartbeats = {}

-- 获取火堆实例（Campground/MainFire）
local function getFirePlace()
    local campground = workspace:FindFirstChild("Campground")
    if campground then
        return campground:FindFirstChild("MainFire")
    end
    return nil
end

-- 创建红色球体（高度可调，这里默认 Y=14）
local function createTargetSphere()
    local existing = workspace:FindFirstChild("FireTargetSphere")
    if existing then existing:Destroy() end
    local firePlace = getFirePlace()
    local basePos = firePlace and (firePlace:GetPivot().Position + Vector3.new(0, 14, 1)) or Vector3.new(0, 14, 1)
    local sphere = Instance.new("Part")
    sphere.Name = "FireTargetSphere"
    sphere.Shape = Enum.PartType.Ball
    sphere.Size = Vector3.new(7, 7, 7)
    sphere.CFrame = CFrame.new(basePos)
    sphere.BrickColor = BrickColor.new("Really red")
    sphere.Material = Enum.Material.Neon
    sphere.Anchored = true
    sphere.CanCollide = false
    sphere.Parent = workspace
    print("篝火球体已创建，中心位置", basePos)
    return sphere
end

-- 删除现有的 AntiChea 文件夹和 AntiFlingClient 脚本
local function deleteExistingAntiCheats()
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("Folder") and obj.Name == "AntiChea" then
            obj:Destroy()
            print("已删除 AntiChea 文件夹:", obj.Name)
        elseif (obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript")) and obj.Name == "AntiFlingClient" then
            obj:Destroy()
            print("已删除 AntiFlingClient 脚本:", obj.Name)
        end
    end
end

-- 传送并燃烧单个木头（瞬移+短暂锁定防回弹）
local function teleportAndBurn(outer)
    if not outer or not outer.Parent then return end
    if not fireTargetSphere or not fireTargetSphere.Parent then return end
    local root = outer:IsA("BasePart") and outer or (outer.PrimaryPart or outer:FindFirstChildWhichIsA("BasePart"))
    if not root then return end

    root.CFrame = CFrame.new(fireTargetSphere.Position)

    local heartbeatConn
    local startTime = tick()
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if tick() - startTime > 0.3 then
            if heartbeatConn then heartbeatConn:Disconnect() end
            return
        end
        if root and root.Parent then
            root.CFrame = CFrame.new(fireTargetSphere.Position)
        else
            if heartbeatConn then heartbeatConn:Disconnect() end
        end
    end)
    table.insert(heartbeats, heartbeatConn)

    if startDrag then
        pcall(function() startDrag:FireServer(outer) end)
        print("已执行拖拽")
    end

    local fire = getFirePlace()
    if fire and burnEvent then
        task.wait(0.05)
        pcall(function() burnEvent:FireServer(fire, outer) end)
        print("木头已提交到篝火")
    end
end

-- 处理已有的 Outer
local function handleExistingOuter()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Outer" then
            teleportAndBurn(obj)
        end
    end
end

-- 开启功能
local function startAll()
    if enabled then return end
    enabled = true

    deleteExistingAntiCheats()
    if antiCleanupConn then antiCleanupConn:Disconnect() end
    antiCleanupConn = game.DescendantAdded:Connect(function(obj)
        if obj:IsA("Folder") and obj.Name == "AntiChea" then
            obj:Destroy()
            print("已删除新出现的 AntiChea 文件夹")
        elseif (obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript")) and obj.Name == "AntiFlingClient" then
            obj:Destroy()
            print("已删除新出现的 AntiFlingClient 脚本")
        end
    end)

    fireTargetSphere = createTargetSphere()
    handleExistingOuter()

    if outerListenerConn then outerListenerConn:Disconnect() end
    outerListenerConn = workspace.DescendantAdded:Connect(function(obj)
        if obj.Name == "Outer" and enabled then
            task.wait(0.05)
            teleportAndBurn(obj)
        end
    end)

    print("[系统] 已开启：自动删除 AntiChea/AntiFlingClient + 木头瞬移篝火")
end

-- 关闭功能
local function stopAll()
    if not enabled then return end
    enabled = false

    if antiCleanupConn then antiCleanupConn:Disconnect(); antiCleanupConn = nil end
    if outerListenerConn then outerListenerConn:Disconnect(); outerListenerConn = nil end

    for _, conn in ipairs(heartbeats) do
        if conn then pcall(conn.Disconnect, conn) end
    end
    heartbeats = {}

    if fireTargetSphere and fireTargetSphere.Parent then
        fireTargetSphere:Destroy()
        fireTargetSphere = nil
    end

    print("[系统] 已关闭")
end

